# Reference: <https://postmarketos.org>
maintainer=""
pkgname=firmware-xiaomi-chiron
pkgver=1.0
pkgrel=1
pkgdesc="Firmware for Xiaomi Mi MIX 2 (chiron)"
url="https://postmarketos.org"
replaces="linux-firmware-ath10k"
arch="aarch64"
depends="firmware-qcom-adreno-a530 linux-firmware-qca soc-qcom-msm8998-nonfree-firmware"
license="proprietary"
options="!check !archcheck !strip !tracedeps"
source="
	$pkgname-$pkgver.tar.xz
	30-gpu-firmware.files
	firmware.files
"
subpackages="
	$pkgname-initramfs:firmware_initramfs
	$pkgname-openrc
	"
builddir="$srcdir/$pkgname-$pkgver"

package() {
	while IFS="" read -r fw; do
		install -Dm644 "$fw" "$pkgdir/lib/firmware/$fw"
	done < "$srcdir"/firmware.files

	mkdir -p "$pkgdir"/lib/firmware/ath10k/WCN3990/hw1.0
	ln -sf /lib/firmware/qcom/msm8998/xiaomi/wlanmdsp.mbn \
		"$pkgdir"/lib/firmware/ath10k/WCN3990/hw1.0/wlanmdsp.mbn
}

firmware_initramfs() {
	pkgdesc="Files to be included in the initramfs to support osk-sdl"
	depends="$pkgname mesa-egl mesa-gbm"
	install_if="$pkgname"

	install -Dm644 "$srcdir"/30-gpu-firmware.files \
		"$subpkgdir"/usr/share/mkinitfs/files/30-gpu-firmware.files
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="qcom-diag-openrc rmtfs-openrc tqftpserv-openrc openrc"

	mkdir -p "$subpkgdir"
}

