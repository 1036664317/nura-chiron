# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-xiaomi-chiron
pkgdesc="Xiaomi Mi MIX 2"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	mkbootimg
	postmarketos-base
	linux-postmarketos-qcom-msm8998
	soc-qcom
	soc-qcom-msm8998
	firmware-xiaomi-chiron
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	modules-load.conf
	phoc.ini
	gpu-nobin.sh
"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-phosh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/gpu-nobin.sh \
		"$pkgdir"/etc/profile.d/gpu-nobin.sh
	mkdir -p "$pkgdir"/etc/environment.d
	echo "FD_MESA_DEBUG=nobin" > "$pkgdir"/etc/environment.d/10-freedreno.conf
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, Wi-Fi, Bluetooth etc. (mainline only, also needed for osk-sdl)"
	depends="firmware-xiaomi-chiron"
	mkdir "$subpkgdir"
}

phosh() {
	install_if="$pkgname postmarketos-ui-phosh"
	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini
}

